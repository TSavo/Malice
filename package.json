{
  "name": "malice-v2",
  "version": "2.0.0",
  "type": "module",
  "description": "Malice - Modern TypeScript Reactive TMMO",
  "author": "Travis Savo <evilgenius@nefariousplan.com>",
  "license": "MIT",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && node --import tsx src/scripts/check-moo-methods.ts",
    "moo:check": "node --import tsx src/scripts/check-moo-methods.ts",
    "bootstrap:world": "node --import tsx src/scripts/bootstrap-world.ts --systems",
    "bootstrap:world:full": "node --import tsx src/scripts/bootstrap-world.ts --full",
    "bootstrap:apply": "node --import tsx src/scripts/bootstrap-apply.ts",
    "bootstrap:force": "node --import tsx src/scripts/bootstrap-apply.ts --force",
    "bootstrap:e2e": "node --import tsx src/scripts/bootstrap-e2e.ts",
    "docker:rebuild": "docker compose down && docker volume rm malice_mongodb_data malice_mongodb-data 2>/dev/null; docker compose build game && docker compose up -d",
    "docker:reset": "bash scripts/docker-reset.sh",
    "lint": "biome check .",
    "format": "biome format --write .",
    "lint:fix": "biome check --fix ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.309",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "bcrypt": "^6.0.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.7",
    "mongodb": "^7.7.0",
    "oxipng-bin": "^1.0.0",
    "resend": "^6.34.1",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "ssh2": "^1.17.0",
    "tsx": "^4.23.15",
    "uuid": "^13.0.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.16",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "latest",
    "@types/node": "^25.0.9",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^4.0.17",
    "@vitest/ui": "^4.0.15",
    "typescript": "^5.6.3",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.0"
  }
}
