{
  "name": "malice-v2",
  "version": "2.0.0",
  "type": "module",
  "description": "Malice - Modern TypeScript Reactive TMMO",
  "author": "Travis Savo <evilgenius@nefariousplan.com>",
  "license": "MIT",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "bootstrap:world": "node --import tsx src/scripts/bootstrap-world.ts --systems",
    "bootstrap:world:full": "node --import tsx src/scripts/bootstrap-world.ts --full",
    "bootstrap:apply": "node --import tsx src/scripts/bootstrap-apply.ts",
    "bootstrap:force": "node --import tsx src/scripts/bootstrap-apply.ts --force",
    "bootstrap:e2e": "node --import tsx src/scripts/bootstrap-e2e.ts",
    "docker:rebuild": "docker compose down && docker volume rm malice_mongodb_data malice_mongodb-data 2>/dev/null; docker compose build game && docker compose up -d",
    "docker:reset": "docker compose down && docker compose build game && docker compose up -d mongodb && sleep 3 && docker exec malice-mongo mongosh --quiet --eval 'db.dropDatabase()' malice && npm run bootstrap:world:full && docker compose up -d game",
    "lint": "biome check .",
    "format": "biome format --write .",
    "lint:fix": "biome check --fix ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.69",
    "@modelcontextprotocol/sdk": "^1.24.3",
    "bcrypt": "^5.1.1",
    "fastify": "^5.6.2",
    "mongodb": "^7.0.0",
    "rxjs": "^7.8.1",
    "ssh2": "^1.17.0",
    "tsx": "^4.19.0",
    "uuid": "^10.0.0",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@types/bcrypt": "^5.0.2",
    "@types/bun": "latest",
    "@types/node": "^24.10.1",
    "@types/ssh2": "^1.15.5",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.12",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.15",
    "typescript": "^5.6.3",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.0"
  }
}
