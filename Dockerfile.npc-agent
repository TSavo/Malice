# NPC Agent Service
# AI-powered NPCs using Claude Agent SDK
#
# Runs as a separate container with:
# - Session files persisted in /app/.claude volume
# - Connects to game MCP server over network
# - Session IDs stored in MongoDB via MCP

FROM node:20

# Use existing 'node' user (UID 1000) - matches typical host user

WORKDIR /app

# Match official Claude devcontainer setup
ENV DEVCONTAINER=true

# Install Claude Code CLI for SDK runtime
RUN npm install -g @anthropic-ai/claude-code

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source
COPY src ./src
COPY types ./types
COPY tsconfig.json ./

# Copy world knowledge docs for NPC reference
COPY docs/city-ai ./docs/city-ai

# Entry point script
COPY npc-agent-service.ts ./

# Give node user ownership of app directory
RUN chown -R node:node /app

# Set Claude home for credentials (mounted from host)
ENV CLAUDE_CONFIG_DIR=/home/node/.claude

# Default MCP server location (game container)
ENV MCP_HOST=malice-game
ENV MCP_PORT=3001

# Switch to non-root user (UID 1000)
USER node

CMD ["npx", "tsx", "npc-agent-service.ts"]
