# VibeVoice Server Configuration

# GPU device ID (default: 0)
GPU_DEVICE_ID=0

# Port to expose (default: 8880)
PORT=8880

# Model path - choose one:
#   DevParker/VibeVoice7b-low-vram     - 7B 4-bit (~6.6GB VRAM, higher quality)
#   microsoft/VibeVoice-1.5B           - 1.5B (~7GB VRAM, good quality)
#   microsoft/VibeVoice-Realtime-0.5B  - 0.5B (~2GB VRAM, fastest streaming)
MODEL_PATH=DevParker/VibeVoice7b-low-vram

# Device: cuda, cpu
MODEL_DEVICE=cuda

# Inference steps (5-50, higher = better quality but slower)
# Recommended: 32 for 7B, 10 for streaming
INFERENCE_STEPS=32

# CFG scale for 7B model (1.0-3.0, controls adherence to text)
CFG_SCALE=2.0

# Default voice (leave empty for model default)
DEFAULT_VOICE=
