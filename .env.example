# Production Server
# Copy to .env and fill in your values
PRODUCTION_IP=your.server.ip.here
PRODUCTION_HOST=malice.world

# Bootstrap flag (set to true to rebuild world on startup)
FORCE_BOOTSTRAP=false

# Email Service (Resend API)
# Get key from https://resend.com/api-keys
EMAIL_API_KEY=re_xxxxxxxxxx

# DigitalOcean API (for MCP server management)
# Get token from https://cloud.digitalocean.com/account/api/tokens
DIGITALOCEAN_API_TOKEN=dop_v1_xxxxxxxxxx

# Cloudflare DNS Management (for MCP DNS updates)
# Get token from https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=xxxxxxxxxx
CLOUDFLARE_ZONE_MALICE=xxxxxxxxxx
CLOUDFLARE_ZONE_CARTEL=xxxxxxxxxx
CLOUDFLARE_ZONE_CONTINUUM=xxxxxxxxxx

# AI Image Generation (laozhang.ai - Nano Banana proxy)
# Get key from https://api.laozhang.ai
LAOZHANG_API_KEY=sk-xxxxxxxxxx

# GitHub Actions Self-Hosted Runner
# Get token from https://github.com/settings/tokens
# Required scopes: repo (for private repos)
GITHUB_TOKEN=ghp_xxxxxxxxxx
GITHUB_REPOSITORY=yourorg/Malice
RUNNER_NAME=malice-prod
RUNNER_LABELS=self-hosted,Linux,X64,malice,production
