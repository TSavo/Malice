# Malice Environment Variables
#
# Setup:
#   1. Copy this file to .env: cp .env.example .env
#   2. Fill in your values below
#   3. Keep a backup at ~/.config/malice/.env for persistence across clones
#
# To restore from backup: cp ~/.config/malice/.env .env

# GitHub Token (for CI runners)
GITHUB_TOKEN=ghp_xxxxxxxxxx

# Production Server
PRODUCTION_IP=your.server.ip.here
PRODUCTION_HOST=malice.world

# Bootstrap flag (set to true to rebuild world on startup)
FORCE_BOOTSTRAP=false

# Email Service (Resend API)
# Get key from https://resend.com/api-keys
EMAIL_API_KEY=re_xxxxxxxxxx

# DigitalOcean API (for MCP server management)
# Get token from https://cloud.digitalocean.com/account/api/tokens
DIGITALOCEAN_API_TOKEN=dop_v1_xxxxxxxxxx

# Cloudflare DNS Management (for MCP DNS updates)
# Get token from https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=xxxxxxxxxx
CLOUDFLARE_ZONE_MALICE=xxxxxxxxxx
CLOUDFLARE_ZONE_CARTEL=xxxxxxxxxx
CLOUDFLARE_ZONE_CONTINUUM=xxxxxxxxxx

# Midjourney API (via Discord bot)
# Requires a Discord account with MidJourney subscription
# Get SALAI_TOKEN from Discord DevTools: Application > Local Storage > token
# WARNING: SALAI_TOKEN is a highly sensitive credential that grants full account access.
# Treat it like a password - never commit it to version control or share publicly.
MIDJOURNEY_SERVER_ID=your_discord_server_id
MIDJOURNEY_CHANNEL_ID=your_discord_channel_id
MIDJOURNEY_SALAI_TOKEN=your_discord_token
MIDJOURNEY_DEBUG=false
# Optional: HuggingFace token for human verification
HUGGINGFACE_TOKEN=hf_xxxxxxxxxx

# Cloudflare API token for wildcard SSL certs (DNS-01 challenge)
CLOUDFLARE_API_TOKEN=
