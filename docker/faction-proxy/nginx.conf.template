# Faction Proxy - forwards standard ports to game container's faction ports
# Uses envsubst to replace ${VARIABLES} at container startup

worker_processes 1;

events {
    worker_connections 1024;
}

# TCP stream proxying for SSH and Telnet
stream {
    # SSH - port 22 -> game:${SSH_PORT}
    upstream ssh_backend {
        server ${GAME_HOST}:${SSH_PORT};
    }
    server {
        listen 22;
        proxy_pass ssh_backend;
        proxy_connect_timeout 60s;
        proxy_timeout 600s;
    }

    # Telnet - port 23 -> game:${TELNET_PORT}
    upstream telnet_backend {
        server ${GAME_HOST}:${TELNET_PORT};
    }
    server {
        listen 23;
        proxy_pass telnet_backend;
        proxy_connect_timeout 60s;
        proxy_timeout 600s;
    }

    # WebSocket - port 8080 -> game:${WS_PORT}
    upstream ws_backend {
        server ${GAME_HOST}:${WS_PORT};
    }
    server {
        listen 8080;
        proxy_pass ws_backend;
        proxy_connect_timeout 60s;
        proxy_timeout 600s;
    }
}

# HTTP proxying
http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    sendfile        on;
    keepalive_timeout  65;

    # HTTP - port 80 -> game:${HTTP_PORT}
    upstream http_backend {
        server ${GAME_HOST}:${HTTP_PORT};
    }

    server {
        listen 80;
        server_name _;

        location / {
            proxy_pass http://http_backend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # WebSocket support for /mux endpoint
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_read_timeout 86400;
        }
    }
}
